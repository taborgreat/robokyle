# Baked into the bundle at build time, so this is the URL the GitHub Pages site
# will call. Committed on purpose: it's not a secret, and it keeps `npm run build`
# reproducible. Dev is deliberately left unset (see .env.example) so `npm run dev`
# keeps using the Vite proxy to localhost:4000.
VITE_API_URL=https://api.robokyle.org
