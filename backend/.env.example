PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/robokyle
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API (the GitHub Pages site + local React dev server)
CORS_ORIGINS=https://robokyle.org,https://www.robokyle.org,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500
MAX_UPLOAD_MB=50
# Only admins may attach uploaded files; everyone else uses external links.
# Set to false to let any signed-in member upload.
UPLOADS_ADMIN_ONLY=true

# Public origin of the site, used to build the links inside verification emails
SITE_URL=https://robokyle.org

# Google sign-in: the OAuth 2.0 Web application client ID from
# console.cloud.google.com > APIs & Services > Credentials. Leave blank to hide
# the Google button and disable /api/auth/google.
GOOGLE_CLIENT_ID=

# Outgoing mail for email verification, sent from the site's own Gmail account.
# SMTP_PASS is a Google App Password (16 characters, needs 2FA on the account):
# myaccount.google.com > Security > 2-Step Verification > App passwords.
# While SMTP_PASS is blank nothing is sent, the link is logged to the server
# console instead, and verification is not enforced.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=robokyleorg@gmail.com
SMTP_PASS=
MAIL_FROM=Robo Kyle <robokyleorg@gmail.com>

# Sign-ups that never confirm are deleted this many hours after they are made,
# and the verification link expires with them.
UNVERIFIED_TTL_HOURS=12

# Leave unset to require verification only when SMTP is configured.
# REQUIRE_EMAIL_VERIFICATION=true
