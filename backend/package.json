{
  "name": "robokyle-server",
  "version": "0.1.0",
  "private": true,
  "description": "API server for robokyle.org: accounts and community design uploads",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "admin": "node scripts/role.js",
    "users": "node scripts/role.js --list",
    "purge": "node -e \"require('dotenv').config();const m=require('mongoose');m.connect(process.env.MONGO_URI||'mongodb://127.0.0.1:27017/robokyle').then(()=>require('./lib/cleanup').purgeUnverified()).then(r=>console.log(r)).finally(()=>m.disconnect())\"",
    "build:app": "npm --prefix ../frontend_react run build",
    "start:all": "npm run build:app && npm start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5"
  }
}
